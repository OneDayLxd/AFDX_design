{
    "files.eol": "\n",

    "verilog.linting.linter": "modelsim",

    // 打开文件时不检查，保存时检查。
    "verilog.linting.runOnOpen": false,
    "verilog.linting.runOnSave": true,

    // 在项目根目录运行检查，编译库与源代码、仿真工作库分开存放。
    "verilog.linting.modelsim.runAtFileLocation": false,
    "verilog.linting.modelsim.work": "D:\\Desktop\\CCWork\\FPGA\\AFDX_design\\lint_work",

    // 从项目配置文件读取 lint 参数。
    "verilog.linting.modelsim.arguments": "-modelsimini modelsim.ini -f .vscode/lint.f"
}
